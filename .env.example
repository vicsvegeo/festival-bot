# Bot token from the Discord Developer Portal (Bot page, "Reset Token").
DISCORD_BOT_TOKEN=

# Postgres connection string. In production this is a `festival` database on
# the Planka Postgres server. Format: postgres://user:password@host:port/database
DATABASE_URL=

# Optional. Lets the bot read rotation end times from Epic's calendar
# ("leaves in 2 days", last-day reminders). Create it once with
# `npm run epic-login -- <authorizationCode>` (see scripts/epic-login.ts).
# Format: accountId:deviceId:secret. Without it, rotation comes from
# fnfestival.co and has no end times.
EPIC_DEVICE_AUTH=

# clientId:secret of the Fortnite iOS game client (the community-known
# fortniteIOSGameClient pair). Needed by EPIC_DEVICE_AUTH and epic-login.
EPIC_CLIENT=
